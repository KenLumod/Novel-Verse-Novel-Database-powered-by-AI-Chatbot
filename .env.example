# =================================================================
# NovelVerse - Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file with secrets to Git.
# =================================================================

# --- Supabase Database Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role key only in server environment variables; never expose it
# in frontend JavaScript. The schema enables RLS and denies anon/authenticated.
SUPABASE_KEY=your-supabase-service-role-key

# --- AI & LLM Provider Settings ---
# Provider options: "groq" (Recommended Free), "gemini", or "mock"
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Alternative: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# --- Embedding Configuration ---
# Options:
# "local"        -> Uses sentence-transformers (all-MiniLM-L6-v2, 384 dimensions).
# "huggingface"  -> Calls the hosted all-MiniLM-L6-v2 inference API (Vercel-friendly).
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
HF_TOKEN=hf_your_inference_providers_token_here

# --- Admin login ---
# Password is stored as a hash, never as plain text.
# Format: pbkdf2_sha256$<rounds>$<salt>$<hex digest>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$200000$salt$hexdigest
ADMIN_SECRET=replace-with-a-long-random-string

# --- Server Settings ---
PORT=8000
HOST=127.0.0.1
# Same-origin deployment needs no CORS origins. For a separate frontend, use
# a comma-separated list of exact HTTPS origins, never '*'.
CORS_ORIGINS=
COOKIE_SECURE=true

